{
  "name": "agrivoice",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "setup:local": "tsx scripts/setup-local.ts",
    "dev": "tsx scripts/dev.ts",
    "build": "npm run build -w apps/web",
    "lint": "eslint .",
    "typecheck": "tsc -p tsconfig.json && tsc -p apps/web/tsconfig.scripts.json",
    "test": "vitest run",
    "check": "npm run lint && npm run typecheck && npm run test",
    "e2e": "npm run build -w apps/web && playwright test --trace off",
    "db:migrate": "tsx scripts/db.ts migrate",
    "db:seed": "tsx scripts/db.ts seed",
    "db:seed:demo": "tsx scripts/db.ts seed-demo",
    "admin:hash": "tsx scripts/admin-hash.ts",
    "purge": "tsx scripts/db.ts purge",
    "db:seed:locations": "tsx scripts/db.ts seed-locations",
    "telegram:secret": "tsx scripts/telegram-secret.ts",
    "build:sql": "tsx scripts/build-sql.ts"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@cloudflare/workers-types": "^5.0.0",
    "@eslint/js": "^9.0.0",
    "@playwright/test": "1.63.0",
    "@types/node": "^22.0.0",
    "astro": "^5.0.0",
    "eslint": "^9.0.0",
    "prettier": "^3.0.0",
    "tsx": "^4.23.15",
    "typescript": "^5.6.0",
    "typescript-eslint": "^8.0.0",
    "vitest": "^3.0.0",
    "wrangler": "^4.0.0"
  },
  "dependencies": {
    "@hono/node-server": "^1.19.19",
    "hono": "^4.6.0",
    "zod": "^3.23.0"
  }
}